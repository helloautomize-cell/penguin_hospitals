# GA4 measurement ID (public). Analytics loads only after cookie Accept.
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Resend: API key for sending form emails to the clinic.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Verified sender address (domain must be verified in Resend). [CONFIRM]
RESEND_FROM=website@penguinhospitals.com
# Clinic inbox that receives form submissions.
CLINIC_EMAIL=penguinhospitals@gmail.com
# Set to "1" in production to fail launch-check when email is not configured.
REQUIRE_EMAIL=0

# Cloudflare Turnstile (spam protection; forms work without them using
# honeypot + min fill time).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
